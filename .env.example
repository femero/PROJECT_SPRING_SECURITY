# Database
DB_URL=jdbc:postgresql://localhost:5432/securitydb
DB_USERNAME=securityuser
DB_PASSWORD=securitypass
POSTGRES_DB=securitydb
POSTGRES_USER=securityuser
POSTGRES_PASSWORD=securitypass

# JWT
JWT_SECRET_KEY=your-256-bit-secret-key-here-minimum-32-characters
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Application
SPRING_PROFILES_ACTIVE=prod
